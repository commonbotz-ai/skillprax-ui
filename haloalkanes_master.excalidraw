      "text": "THIOETHER SYNTHESIS: NaSR' + R-X",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "THIOETHER SYNTHESIS: NaSR' + R-X",
      "lineHeight": 1.25
    },
    {
      "id": "1c922c24-4a0a-462f-9dc2-908abea9b8dd",
      "type": "text",
      "x": 4406,
      "y": 2226,
      "width": 556.8,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THIOETHER / SULPHIDE SYNTHESIS (TABLE 6.4)\n\u2022 Reaction: R-X + NaSR' -> R-S-R' (Dialkyl Sulphide / Thioether) + NaX.\n\u2022 Analogous to Williamson Ether synthesis, utilizing sodium mercaptide.\n\u2022 Oxidation of Thioethers: R-S-R' --(H2O2)--> Sulphoxide -> Sulphone (R-SO2-R').",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "THIOETHER / SULPHIDE SYNTHESIS (TABLE 6.4)\n\u2022 Reaction: R-X + NaSR' -> R-S-R' (Dialkyl Sulphide / Thioether) + NaX.\n\u2022 Analogous to Williamson Ether synthesis, utilizing sodium mercaptide.\n\u2022 Oxidation of Thioethers: R-S-R' --(H2O2)--> Sulphoxide -> Sulphone (R-SO2-R').",
      "lineHeight": 1.25
    },

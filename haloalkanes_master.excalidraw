    {
      "id": "66bab948-cf00-4135-8a3d-6dbc946cdeff",
      "type": "text",
      "x": 5406,
      "y": 2226,
      "width": 528.96,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

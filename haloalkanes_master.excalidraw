    },
    {
      "id": "6ca10e1e-9aeb-46c8-b05a-e8268862b9e8",
      "type": "text",
      "x": 3066,
      "y": 2726,
      "width": 696.0,
      "height": 129.6,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DOW'S PROCESS & ELECTRON-WITHDRAWING ACTIVATION\n\u2022 Unsubstituted Chlorobenzene: 6-8% aq. NaOH, 623 K, 300 atm, followed by H+ -> Phenol.\n\u2022 Drastic conditions mandatory due to resonance stabilization of chlorobenzene.\n\u2022 Activation by Electron-Withdrawing Nitro (-NO2) Groups at Ortho and Para positions:\n  - 4-Nitrochlorobenzene: aq. NaOH, 443 K, H+ -> 4-Nitrophenol.\n  - 2,4-Dinitrochlorobenzene: aq. Na2CO3, 368 K, H+ -> 2,4-Dinitrophenol.\n  - 2,4,6-Trinitrochlorobenzene (Picric Chloride): Warm water (323 K) -> Picric Acid (100% yield!).\n\u2022 Reason: Carbanion intermediate (Meisenheimer complex) is resonance-stabilized by -NO2 only at o/p.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "DOW'S PROCESS & ELECTRON-WITHDRAWING ACTIVATION\n\u2022 Unsubstituted Chlorobenzene: 6-8% aq. NaOH, 623 K, 300 atm, followed by H+ -> Phenol.\n\u2022 Drastic conditions mandatory due to resonance stabilization of chlorobenzene.\n\u2022 Activation by Electron-Withdrawing Nitro (-NO2) Groups at Ortho and Para positions:\n  - 4-Nitrochlorobenzene: aq. NaOH, 443 K, H+ -> 4-Nitrophenol.\n  - 2,4-Dinitrochlorobenzene: aq. Na2CO3, 368 K, H+ -> 2,4-Dinitrophenol.\n  - 2,4,6-Trinitrochlorobenzene (Picric Chloride): Warm water (323 K) -> Picric Acid (100% yield!).\n\u2022 Reason: Carbanion intermediate (Meisenheimer complex) is resonance-stabilized by -NO2 only at o/p.",
      "lineHeight": 1.25
    },

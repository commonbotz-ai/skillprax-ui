    {
      "id": "a5124177-ed8b-4a3e-8349-8455567bef93",
      "type": "text",
      "x": 3060,
      "y": 170,
      "width": 95.7,
      "height": 14.85,
      "angle": 0,
      "strokeColor": "#334155",

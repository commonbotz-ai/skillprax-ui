    },
    {
      "id": "6f7b56de-01ca-4eea-8ca3-0f5dee000adf",
      "type": "text",
      "x": 966,
      "y": 1846,
      "width": 584.64,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "VICINAL DIHALIDE [R-CH(X)-CH2(X)]\n\u2022 Formation: Alkene + X2 in CCl4 solvent (anti-addition).\n\u2022 Bromine Water Test: Reddish-brown colour of Br2/CCl4 is rapidly discharged.\n\u2022 Unsaturation Test: Confirms presence of alkene / alkyne carbon double/triple bond.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "VICINAL DIHALIDE [R-CH(X)-CH2(X)]\n\u2022 Formation: Alkene + X2 in CCl4 solvent (anti-addition).\n\u2022 Bromine Water Test: Reddish-brown colour of Br2/CCl4 is rapidly discharged.\n\u2022 Unsaturation Test: Confirms presence of alkene / alkyne carbon double/triple bond.",
      "lineHeight": 1.25
    },

    {
      "id": "e329804a-2b7c-4c17-b7fc-ea80c24b21d0",
      "type": "text",
      "x": 3746,
      "y": 796,
      "width": 570.72,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FORMULA: CHCl3 (Trichloromethane, b.p. 334 K)\nProduction: Haloform reaction on ethanol/acetone with bleaching powder CaOCl2.\nAuto-Oxidation Hazard: 2 CHCl3 + O2 --(light / air)--> 2 COCl2 (Phosgene) + 2 HCl.\nStorage Safeguard: Stored in completely filled, dark amber bottles + 1% ethanol.\nRole of 1% EtOH: Reacts with phosgene -> non-toxic Diethyl Carbonate (C2H5O)2CO.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "FORMULA: CHCl3 (Trichloromethane, b.p. 334 K)\nProduction: Haloform reaction on ethanol/acetone with bleaching powder CaOCl2.\nAuto-Oxidation Hazard: 2 CHCl3 + O2 --(light / air)--> 2 COCl2 (Phosgene) + 2 HCl.\nStorage Safeguard: Stored in completely filled, dark amber bottles + 1% ethanol.\nRole of 1% EtOH: Reacts with phosgene -> non-toxic Diethyl Carbonate (C2H5O)2CO.",
      "lineHeight": 1.25
    },

      "text": "ESTER SYNTHESIS: R'COOAg + R-X",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "ESTER SYNTHESIS: R'COOAg + R-X",
      "lineHeight": 1.25
    },
    {
      "id": "11939ac7-44a0-4d99-9729-98c87913e022",
      "type": "text",
      "x": 3386,
      "y": 2226,
      "width": 563.76,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ESTERS VIA SILVER SALTS (TABLE 6.4)\n\u2022 Reaction: R-X + R'COOAg --(heat)--> R'COOR + AgX(s).\n\u2022 Nucleophilic displacement of halide by carboxylate ion (R'COO-).\n\u2022 High purity: Insoluble silver halide precipitate drives reaction to completion.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "ESTERS VIA SILVER SALTS (TABLE 6.4)\n\u2022 Reaction: R-X + R'COOAg --(heat)--> R'COOR + AgX(s).\n\u2022 Nucleophilic displacement of halide by carboxylate ion (R'COO-).\n\u2022 High purity: Insoluble silver halide precipitate drives reaction to completion.",
      "lineHeight": 1.25
    },

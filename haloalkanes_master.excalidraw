    },
    {
      "id": "fa4ed0a3-a223-4ca6-9e66-a0437cc47ec9",
      "type": "text",
      "x": 316,
      "y": 1466,
      "width": 612.48,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SATURATED HYDROCARBON [R-H / CH3-CH3]\n\u2022 Free Radical Halogenation: RH + X2 --(h\u03bd / 573-773 K)--> RX + HX\n\u2022 Hydrogen Reactivity Order: 3\u00b0 H (tertiary) > 2\u00b0 H (secondary) > 1\u00b0 H (primary)\n\u2022 Halogen Reactivity: F2 (explosive) >> Cl2 (unselective) > Br2 (highly selective) >> I2\n\u2022 Iodination is reversible: requires HNO3 or HIO3 oxidizing agent to destroy HI.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "SATURATED HYDROCARBON [R-H / CH3-CH3]\n\u2022 Free Radical Halogenation: RH + X2 --(h\u03bd / 573-773 K)--> RX + HX\n\u2022 Hydrogen Reactivity Order: 3\u00b0 H (tertiary) > 2\u00b0 H (secondary) > 1\u00b0 H (primary)\n\u2022 Halogen Reactivity: F2 (explosive) >> Cl2 (unselective) > Br2 (highly selective) >> I2\n\u2022 Iodination is reversible: requires HNO3 or HIO3 oxidizing agent to destroy HI.",
      "lineHeight": 1.25
    },

    {
      "id": "05176fd4-8eed-40f7-8715-2be200bc93b5",
      "type": "text",
      "x": 2396,
      "y": 3816,
      "width": 640.32,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WURTZ-FITTIG REACTION [ALKYLARENE SYNTHESIS]\n\u2022 Reaction: Ar-X + R-X + 2 Na --(dry ether)--> Ar-R (Alkylbenzene) + 2 NaX.\n\u2022 Example: Bromobenzene + Bromomethane + 2 Na -> Toluene (C6H5CH3) + 2 NaBr.\n\u2022 Vastly superior to Friedel-Crafts alkylation: Absolutely avoids carbocation rearrangements\n  and polyalkylation side-products (e.g. 1-bromopropane gives pure n-propylbenzene!).",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "WURTZ-FITTIG REACTION [ALKYLARENE SYNTHESIS]\n\u2022 Reaction: Ar-X + R-X + 2 Na --(dry ether)--> Ar-R (Alkylbenzene) + 2 NaX.\n\u2022 Example: Bromobenzene + Bromomethane + 2 Na -> Toluene (C6H5CH3) + 2 NaBr.\n\u2022 Vastly superior to Friedel-Crafts alkylation: Absolutely avoids carbocation rearrangements\n  and polyalkylation side-products (e.g. 1-bromopropane gives pure n-propylbenzene!).",
      "lineHeight": 1.25
    },

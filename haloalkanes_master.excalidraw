    },
    {
      "id": "b790f9a3-7963-497b-89a8-1f49381ce9f8",
      "type": "text",
      "x": 6356,
      "y": 1846,
      "width": 654.24,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HOFMANN BROMAMIDE DEGRADATION\n\u2022 Reaction: R-CONH2 + Br2 + 4 KOH --(heat)--> R-NH2 + K2CO3 + 2 KBr + 2 H2O.\n\u2022 Stepping Down Carbon Chain: Produces pure 1\u00b0 amine with EXACTLY ONE FEWER CARBON atom.\n\u2022 Intermediates: N-Bromamide -> Alkyl Isocyanate (R-N=C=O) via concerted intramolecular shift.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "HOFMANN BROMAMIDE DEGRADATION\n\u2022 Reaction: R-CONH2 + Br2 + 4 KOH --(heat)--> R-NH2 + K2CO3 + 2 KBr + 2 H2O.\n\u2022 Stepping Down Carbon Chain: Produces pure 1\u00b0 amine with EXACTLY ONE FEWER CARBON atom.\n\u2022 Intermediates: N-Bromamide -> Alkyl Isocyanate (R-N=C=O) via concerted intramolecular shift.",
      "lineHeight": 1.25
    },

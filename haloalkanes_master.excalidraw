    {
      "id": "25aa7fea-5702-4a8f-bfcc-05f82a91909a",
      "type": "text",
      "x": 1566,
      "y": 796,
      "width": 612.48,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",

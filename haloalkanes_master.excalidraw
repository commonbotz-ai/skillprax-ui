    },
    {
      "id": "08c83254-59a6-44e3-84b7-6ff851a5c869",
      "type": "text",
      "x": 3216,
      "y": 796,
      "width": 598.56,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FORMULA: CH2Cl2 (Methylene chloride)\nProduction: CH4 + 2 Cl2 --(h\u03bd)--> CH2Cl2 + 2 HCl\nIndustrial Uses: Paint remover solvent, aerosol propellant, decaffeinating agent.\nPhysiological Hazards: Depresses central nervous system; impairs hearing & vision.\nMetabolized in liver to CO, leading to carboxyhemoglobin formation and tissue hypoxia.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "FORMULA: CH2Cl2 (Methylene chloride)\nProduction: CH4 + 2 Cl2 --(h\u03bd)--> CH2Cl2 + 2 HCl\nIndustrial Uses: Paint remover solvent, aerosol propellant, decaffeinating agent.\nPhysiological Hazards: Depresses central nervous system; impairs hearing & vision.\nMetabolized in liver to CO, leading to carboxyhemoglobin formation and tissue hypoxia.",
      "lineHeight": 1.25
    },

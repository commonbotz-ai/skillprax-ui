      "text": "POLYHALOGEN: DICHLOROMETHANE (CH2Cl2)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "POLYHALOGEN: DICHLOROMETHANE (CH2Cl2)",

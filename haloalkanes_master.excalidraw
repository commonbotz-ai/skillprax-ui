    },
    {
      "id": "5f513352-4625-4ed0-8ce8-20649ccc9418",
      "type": "text",
      "x": 1566,
      "y": 3146,
      "width": 842.16,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HALOARENE ELECTROPHILIC AROMATIC SUBSTITUTION (EAS) PRINCIPLE\n\u2022 Halogen atom has dual opposing effects: Strong electron-withdrawing INDUCTIVE effect (-I) destabilizes arenium ion,\n  while electron-donating RESONANCE effect (+R) delocalizes lone pair into ring specifically at Ortho and Para positions.\n\u2022 Inductive effect is much stronger than resonance effect, so halogen DEACTIVATES benzene ring towards further EAS.\n\u2022 However, resonance effect directs incoming electrophile exclusively to ORTHO and PARA positions.\n\u2022 Para isomer is consistently the MAJOR product due to minimal steric hindrance and crystal symmetry.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "HALOARENE ELECTROPHILIC AROMATIC SUBSTITUTION (EAS) PRINCIPLE\n\u2022 Halogen atom has dual opposing effects: Strong electron-withdrawing INDUCTIVE effect (-I) destabilizes arenium ion,\n  while electron-donating RESONANCE effect (+R) delocalizes lone pair into ring specifically at Ortho and Para positions.\n\u2022 Inductive effect is much stronger than resonance effect, so halogen DEACTIVATES benzene ring towards further EAS.\n\u2022 However, resonance effect directs incoming electrophile exclusively to ORTHO and PARA positions.\n\u2022 Para isomer is consistently the MAJOR product due to minimal steric hindrance and crystal symmetry.",
      "lineHeight": 1.25
    },

      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HIGHER ALKYNE SYNTHESIS (TABLE 6.4)\n\u2022 Reaction: R-X + Na+-C#C-R' -> R-C#C-R' (Higher Alkyne) + NaX.\n\u2022 Sodium alkynide acts as potent acetylide carbanion nucleophile.\n\u2022 Essential requirement: R-X must be primary (1\u00b0) to prevent E2 elimination.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "HIGHER ALKYNE SYNTHESIS (TABLE 6.4)\n\u2022 Reaction: R-X + Na+-C#C-R' -> R-C#C-R' (Higher Alkyne) + NaX.\n\u2022 Sodium alkynide acts as potent acetylide carbanion nucleophile.\n\u2022 Essential requirement: R-X must be primary (1\u00b0) to prevent E2 elimination.",
      "lineHeight": 1.25
    },

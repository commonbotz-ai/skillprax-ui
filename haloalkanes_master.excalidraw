    {
      "id": "8ff20140-5c5b-4a12-b2dc-f9996912f90e",
      "type": "text",
      "x": 1796,
      "y": 2226,
      "width": 598.56,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ALKYL ISOCYANIDE [R-NC / CARBYLAMINE]\n\u2022 Synthesis: R-X + AgCN (aq. EtOH, heat) -> R-NC + AgX (Attack by Nitrogen lone pair).\n\u2022 Physical Property: Extremely foul, offensive, repulsive smelling liquid.\n\u2022 Reduction: R-NC + LiAlH4 (or Na / EtOH) -> Secondary Amine (R-NH-CH3).\n\u2022 Acid Hydrolysis: R-NC + 2 H2O + H+ -> 1\u00b0 Amine (R-NH2) + Formic Acid (HCOOH).",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "ALKYL ISOCYANIDE [R-NC / CARBYLAMINE]\n\u2022 Synthesis: R-X + AgCN (aq. EtOH, heat) -> R-NC + AgX (Attack by Nitrogen lone pair).\n\u2022 Physical Property: Extremely foul, offensive, repulsive smelling liquid.\n\u2022 Reduction: R-NC + LiAlH4 (or Na / EtOH) -> Secondary Amine (R-NH-CH3).\n\u2022 Acid Hydrolysis: R-NC + 2 H2O + H+ -> 1\u00b0 Amine (R-NH2) + Formic Acid (HCOOH).",
      "lineHeight": 1.25
    },

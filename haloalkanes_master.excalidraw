    {
      "id": "a905bbd3-e769-48bb-9068-3cab0710116a",
      "type": "text",
      "x": 5216,
      "y": 3816,
      "width": 682.08,
      "height": 81.0,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ADVANCED COUPLING: ULLMANN & COREY-HOUSE\n\u2022 Ullmann Reaction: 2 Ar-I + Cu powder --(heat in sealed tube, 473 K)--> Ar-Ar (Biphenyl) + Cu2I2.\n\u2022 Corey-House Alkane Synthesis: 2 R-X + 2 Li -> 2 R-Li --(CuI)--> R2CuLi (Gilman Reagent).\n\u2022 Cross-Coupling: R2CuLi + R'-X -> R-R' (Pure unsymmetrical alkane; superior to Wurtz coupling,\n  works cleanly with 1\u00b0, 2\u00b0, and even methyl halides without isomeric alkane mixtures).",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "ADVANCED COUPLING: ULLMANN & COREY-HOUSE\n\u2022 Ullmann Reaction: 2 Ar-I + Cu powder --(heat in sealed tube, 473 K)--> Ar-Ar (Biphenyl) + Cu2I2.\n\u2022 Corey-House Alkane Synthesis: 2 R-X + 2 Li -> 2 R-Li --(CuI)--> R2CuLi (Gilman Reagent).\n\u2022 Cross-Coupling: R2CuLi + R'-X -> R-R' (Pure unsymmetrical alkane; superior to Wurtz coupling,\n  works cleanly with 1\u00b0, 2\u00b0, and even methyl halides without isomeric alkane mixtures).",
      "lineHeight": 1.25
    },

      "text": "ESTER [R-COOR'] (FRUITY ESTER)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "ESTER [R-COOR'] (FRUITY ESTER)",
      "lineHeight": 1.25
    },
    {
      "id": "cee5d9bf-4f88-4b52-9435-c43afa279f08",
      "type": "text",
      "x": 5436,
      "y": 1846,
      "width": 633.36,
      "height": 64.8,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ESTER [R-COOR'] (FISCHER ESTERIFICATION)\n\u2022 Synthesis: R-COOH + R'-OH --(conc. H2SO4, heat)--> R-COOR' + H2O.\n\u2022 Characteristic pleasant fruity fragrance; used in synthetic perfumes and food flavouring.\n\u2022 Saponification: Alkaline hydrolysis with NaOH gives soap (R-COONa) + alcohol R'-OH.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "ESTER [R-COOR'] (FISCHER ESTERIFICATION)\n\u2022 Synthesis: R-COOH + R'-OH --(conc. H2SO4, heat)--> R-COOR' + H2O.\n\u2022 Characteristic pleasant fruity fragrance; used in synthetic perfumes and food flavouring.\n\u2022 Saponification: Alkaline hydrolysis with NaOH gives soap (R-COONa) + alcohol R'-OH.",
      "lineHeight": 1.25
    },

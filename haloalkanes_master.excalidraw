    {
      "id": "7bef475e-9ede-42a1-b0a6-a77963c73626",
      "type": "text",
      "x": 1076,
      "y": 2190,
      "width": 82.94,
      "height": 14.85,
      "angle": 0,
      "strokeColor": "#be123c",
